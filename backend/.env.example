# Environment Variables for Glob ERP Backend
# Copy this to .env and fill in values

# Server
PORT=5000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/glob_erp

# JWT
JWT_SECRET=change-this-to-a-256-bit-random-string-in-production
JWT_EXPIRES_IN=24h

# CORS
CORS_ORIGIN=http://localhost:5173

# SMTP (for password reset emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Glob ERP <your-email@gmail.com>

# Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=2097152

# Rate Limiting
AUTH_RATE_LIMIT=5
API_RATE_LIMIT=100
